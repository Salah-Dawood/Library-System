# The .env file for running BookNest on your PC (docker compose up --build).
# Copy this file to .env next to docker-compose.yml and fill it in. Never commit the real file.

# password of the "postgres" user of the Docker PostgreSQL
DB_PASSWORD=change-me

# shared by every service; a long random Base64 string (at least 32 characters)
JWT_SECRET=change-me

# Gmail address and app password used to send emails
EMAIL_USERNAME=you@gmail.com
EMAIL_PASSWORD=change-me

# address people open in the browser, used in email links (optional, default http://localhost:8080)
PUBLIC_URL=

# password of the sample accounts (librarian, johnd, janed, alexm), set when the database is first created
SEED_PASSWORD=change-me

# login of the pgAdmin page on http://localhost:5050
PGADMIN_EMAIL=you@example.com
PGADMIN_PASSWORD=change-me
