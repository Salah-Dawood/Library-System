# The .env file ON THE AWS SERVER, next to docker-compose.prod.yml. Copy this file there as .env and fill it in.
# Never commit the real file.

# image tag to run (Jenkins sets it on every deploy), for example 1.0.0 or 1.0.0-15db897
VERSION=latest
DOCKERHUB_USER=sala76

# the RDS endpoint (RDS > Databases > booknest-db > Connectivity & security)
DB_HOST=booknest-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PASSWORD=change-me

# shared by every service; a long random Base64 string (at least 32 characters)
JWT_SECRET=change-me

# Gmail address and app password used to send emails
EMAIL_USERNAME=you@gmail.com
EMAIL_PASSWORD=change-me

# the address of the server, used in email links (the Elastic IP, for example http://3.80.12.34)
PUBLIC_URL=http://your-server-ip
